; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VietStage"
run/main_scene="res://scenes/SplashScreen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

DS="*res://scripts/DS.gd"
VirtualArtist="*res://scripts/VirtualArtist.gd"

[display]

window/size/viewport_width=844
window/size/viewport_height=390
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/theme/global_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
