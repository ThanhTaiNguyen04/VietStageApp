[sub_resource type="Shader" id="Shader_avatar_mask"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 centered = UV - vec2(0.5);\n\tfloat mask = 1.0 - smoothstep(0.48, 0.5, length(centered));\n\tvec4 color = texture(TEXTURE, UV);\n\tcolor.a *= mask;\n\tCOLOR = color;\n}\n"

