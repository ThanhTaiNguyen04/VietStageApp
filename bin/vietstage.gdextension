[configuration]

entry_symbol = "vietstage_library_init"
compatibility_minimum = "4.1"

[libraries]

windows.debug.x86_64 = "res://bin/libvietstage.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libvietstage.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libvietstage.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libvietstage.linux.template_release.x86_64.so"
macos.debug = "res://bin/libvietstage.macos.template_debug.framework"
macos.release = "res://bin/libvietstage.macos.template_release.framework"
android.debug.arm64 = "res://bin/libvietstage.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libvietstage.android.template_release.arm64.so"
ios.debug.arm64 = "res://bin/libvietstage.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://bin/libvietstage.ios.template_release.arm64.dylib"
